# Copy to .env.production on the server and fill in. Never commit it.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build

# --- Where it is served ------------------------------------------------------
# Your domain. Caddy gets a certificate for it automatically.
# Use :80 while testing, before DNS points at this box.
SITE_ADDRESS=training.example.co.uk

# --- Database ----------------------------------------------------------------
DB_NAME=teamtraining

# The owner. Runs migrations, and is NOT subject to row-level security.
DB_OWNER=tt_owner
DB_OWNER_PASSWORD=

# The application role. Created by the migration step with this password.
# It has no superuser rights and cannot bypass row-level security, which is
# what keeps one organisation's records away from another's.
DB_APP_USER=tt_app
DB_APP_PASSWORD=

# --- Application -------------------------------------------------------------
# Signs session cookies. Changing it signs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

# Connections per application instance. 10 is ample for one container.
DATABASE_POOL_MAX=10
