{
  "name": "teamtraining",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "verify": "tsx --tsconfig tsconfig.json scripts/verify-integrity.ts",
    "e2e": "node e2e/write-path.mjs",
    "e2e:authoring": "node e2e/authoring.mjs",
    "test": "tsx --test --tsconfig tsconfig.json test/*.test.ts",
    "stress": "tsx --tsconfig tsconfig.json scripts/stress.ts",
    "check": "npm run typecheck && npm test && npm run verify && npm run test:isolation",
    "test:isolation": "tsx --tsconfig tsconfig.json scripts/tenant-isolation.ts",
    "db:sql": "node scripts/apply-sql.mjs",
    "db:sql:print": "node scripts/apply-sql.mjs --print",
    "db:setup": "npm run db:push && npm run db:sql",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "db:demo": "tsx --tsconfig tsconfig.json src/db/demo.ts",
    "e2e:first-run": "node e2e/first-run.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.25",
    "postgres": "^3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
