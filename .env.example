# The application role. Must be a role with NOSUPERUSER and NOBYPASSRLS so that
# row-level security actually applies to it — see drizzle/rls.sql.
DATABASE_URL=postgres://app_user:password@host:5432/teamtraining

# The schema owner, used by migrations and seeding only. Bypasses row-level
# security, so it must never be used to serve a request.
DATABASE_ADMIN_URL=postgres://owner:password@host:5432/teamtraining

# 32+ char random string used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Prepared statements are off by default because transaction-mode
# poolers (PgBouncer, the Neon and Supabase poolers) do not support them. Set to
# true when connecting straight to Postgres, as in the Docker Compose stack.
DATABASE_PREPARE=false

# Optional. Connections per instance. Defaults to 1 on Vercel, 5 elsewhere.
DATABASE_POOL_MAX=5
